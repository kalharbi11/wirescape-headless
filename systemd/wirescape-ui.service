# Install as a user unit in the graphical session, not as a child of the Player.
[Unit]
Description=Wirescape local kiosk
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/chromium --kiosk --no-first-run --user-data-dir=%h/.local/share/wirescape-kiosk http://127.0.0.1:8770/ui/
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
